---
interface SourceLink {
  label: string;
  href: string;
}

interface Props {
  links: SourceLink[];
  label?: string;
}

const { links, label = "Sources officielles" } = Astro.props;
---

<div class="mt-3 flex flex-wrap items-center gap-2" aria-label={label}>
  <span class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-slate-500">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18s-3.332.477-4.5 1.253" />
    </svg>
    {label}
  </span>
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-1.5 rounded-full border border-rose-500/30 bg-rose-500/10 px-2.5 py-1 text-xs font-medium text-rose-200 transition hover:border-rose-400/70 hover:bg-rose-500/20 hover:text-white focus:outline-none focus:ring-2 focus:ring-rose-400/60"
      title={`${link.label} — ouvre la source officielle`}
    >
      <svg class="h-3.5 w-3.5 shrink-0 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0-12 4 4m-4-4L8 7M5 12v6a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-6" />
      </svg>
      <span>{link.label}</span>
      <svg class="h-3 w-3 opacity-60 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5v5m0-5-7 7m5 2v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3" />
      </svg>
    </a>
  ))}
</div>

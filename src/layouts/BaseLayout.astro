---
import '../styles/globals.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import { initI18n, readLang } from '../i18n/astro-i18n';
import { TRANSLATIONS } from '../i18n/translations';

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const lang = readLang();
const T = TRANSLATIONS[lang];
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — FFunds</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-slate-950">
    <!-- Sidebar state is stored on <body data-sidebar-open> so CSS can react.
         A tiny inline script flips the attribute on button click and persists
         the choice in localStorage so a refresh keeps the user's preference. -->
    <script is:inline define:vars={{ initialOpen: true }}>
      try {
        const stored = localStorage.getItem("ffunds:sidebar-open");
        if (stored === "0") document.body.setAttribute("data-sidebar-open", "false");
      } catch {}
    </script>
    <script>
      import { initI18n } from '../i18n/astro-i18n';
      initI18n();
    </script>

    <!-- Floating reopen button — only visible when sidebar is collapsed -->
    <button
      id="sidebar-reopen"
      type="button"
      aria-label={T["site.sidebar.toggle"]}
      class="fixed top-4 left-4 z-50 hidden h-9 w-9 items-center justify-center rounded-lg border border-slate-700 bg-slate-900 text-slate-300 shadow-lg transition-all hover:bg-slate-800 hover:text-slate-100"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <script is:inline>
      const reopenBtn = document.getElementById("sidebar-reopen");
      function syncReopenBtn() {
        const collapsed = document.body.getAttribute("data-sidebar-open") === "false";
        reopenBtn.style.display = collapsed ? "flex" : "none";
      }
      reopenBtn.addEventListener("click", () => {
        document.body.setAttribute("data-sidebar-open", "true");
        try { localStorage.setItem("ffunds:sidebar-open", "1"); } catch {}
        syncReopenBtn();
      });
      syncReopenBtn();
    </script>

    <!-- Sidebar -->
    <aside
      class="sidebar fixed left-0 top-0 z-40 flex h-screen flex-col border-r border-slate-800 bg-slate-950/95 backdrop-blur transition-[width] duration-200 ease-in-out w-60 overflow-hidden"
    >
      <div class="flex items-center gap-2.5 border-b border-slate-800 px-4 py-4 whitespace-nowrap">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/20 shrink-0">
          <span class="text-lg font-bold text-emerald-400">F</span>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-slate-100 leading-tight">FFunds</p>
          <p class="text-[10px] text-slate-500 leading-tight">Portfolio Intelligence</p>
        </div>
        <button
          id="sidebar-toggle"
          type="button"
          aria-label={T["site.sidebar.toggle"]}
          class="shrink-0 inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-500 transition-all hover:bg-slate-800 hover:text-slate-200"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      <script is:inline>
        document.getElementById("sidebar-toggle").addEventListener("click", () => {
          const current = document.body.getAttribute("data-sidebar-open") !== "false";
          const next = current ? "false" : "true";
          document.body.setAttribute("data-sidebar-open", next);
          try { localStorage.setItem("ffunds:sidebar-open", next === "false" ? "0" : "1"); } catch {}
          const reopenBtn = document.getElementById("sidebar-reopen");
          if (reopenBtn) reopenBtn.style.display = next === "false" ? "flex" : "none";
        });
      </script>

      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-0.5">
        <a href="/FFunds" class={`sidebar-link ${currentPath === '/FFunds/' || currentPath === '/FFunds' ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"></path></svg>
          <span data-i18n="nav.home">{T["nav.home"]}</span>
        </a>
        <a href="/FFunds/allocator" class={`sidebar-link ${currentPath.includes('/allocator') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16"></path><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"></circle><circle cx="8" cy="16" r="1.5" fill="currentColor" stroke="none"></circle><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle></svg>
          <span data-i18n="nav.allocator">{T["nav.allocator"]}</span>
        </a>
        <a href="/FFunds/simulations" class={`sidebar-link ${currentPath.includes('/simulations') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
          <span data-i18n="nav.simulations">{T["nav.simulations"]}</span>
        </a>
        <a href="/FFunds/knowledge" class={`sidebar-link ${currentPath.includes('/knowledge') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          <span data-i18n="nav.knowledge">{T["nav.knowledge"]}</span>
        </a>

        <!-- Separator -->
        <div class="my-2 border-t border-slate-800"></div>

        <a href="/FFunds/assurance-vie" class={`sidebar-link ${currentPath.includes('/assurance-vie') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span data-i18n="nav.assurance-vie">{T["nav.assurance-vie"]}</span>
        </a>
        <a href="/FFunds/epargne-retraite" class={`sidebar-link ${currentPath.includes('/epargne-retraite') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span data-i18n="nav.epargne-retraite">{T["nav.epargne-retraite"]}</span>
        </a>
        <a href="/FFunds/luxembourg" class={`sidebar-link ${currentPath.includes('/luxembourg') ? 'active' : ''}`}>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m0 0a9 9 0 019 9"></path></svg>
          <span data-i18n="nav.luxembourg">{T["nav.luxembourg"]}</span>
        </a>
      </nav>

      <div class="border-t border-slate-800 px-3 py-3 space-y-2 whitespace-nowrap">
        <button
          id="lang-toggle"
          type="button"
          aria-label={lang === 'fr' ? 'Switch to English' : 'Passer au français'}
          class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-all hover:bg-slate-800 hover:text-slate-100"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path></svg>
          <span id="lang-toggle-flag" class="text-base leading-none">{lang === 'fr' ? '🇬🇧' : '🇫🇷'}</span>
          <span id="lang-toggle-label">{lang === 'fr' ? 'EN' : 'FR'}</span>
        </button>
        <p class="text-[10px] text-slate-600">FFunds · v0.3.0</p>
      </div>
    </aside>

    <!-- Main content — left margin toggles with sidebar state -->
    <main
      class="main-with-sidebar flex-1 transition-[margin] duration-200 ease-in-out ml-60"
    >
      <div class="mx-auto max-w-7xl px-6 py-8">
        <slot />
      </div>
    </main>
  </body>
</html>

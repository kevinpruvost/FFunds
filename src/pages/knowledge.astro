---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readLang } from '../i18n/astro-i18n';
import { TRANSLATIONS } from '../i18n/translations';

const lang = readLang();
const T = TRANSLATIONS[lang];
---

<BaseLayout title={T["knowledge.title"]} description={T["knowledge.subtitle"]}>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-slate-50" data-i18n="knowledge.title">{T["knowledge.title"]}</h1>
  <p class="mt-1 text-sm text-slate-400" data-i18n="knowledge.subtitle">{T["knowledge.subtitle"]}</p>
</div>

<div class="prose prose-invert prose-slate max-w-3xl space-y-8">

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.concepts">{T["knowledge.concepts"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.concepts.capital">{T["knowledge.concepts.capital"]}</li>
    <li data-i18n="knowledge.concepts.return">{T["knowledge.concepts.return"]}</li>
    <li data-i18n="knowledge.concepts.compound">{T["knowledge.concepts.compound"]}</li>
    <li data-i18n="knowledge.concepts.horizon">{T["knowledge.concepts.horizon"]}</li>
  </ul>
</section>

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.risk">{T["knowledge.risk"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.risk.1">{T["knowledge.risk.1"]}</li>
    <li data-i18n="knowledge.risk.2">{T["knowledge.risk.2"]}</li>
    <li data-i18n="knowledge.risk.3">{T["knowledge.risk.3"]}</li>
  </ul>
</section>

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.funds">{T["knowledge.funds"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.funds.1">{T["knowledge.funds.1"]}</li>
    <li data-i18n="knowledge.funds.2">{T["knowledge.funds.2"]}</li>
    <li data-i18n="knowledge.funds.3">{T["knowledge.funds.3"]}</li>
  </ul>
</section>

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.divers">{T["knowledge.divers"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.divers.1">{T["knowledge.divers.1"]}</li>
    <li data-i18n="knowledge.divers.2">{T["knowledge.divers.2"]}</li>
    <li data-i18n="knowledge.divers.3">{T["knowledge.divers.3"]}</li>
  </ul>
</section>

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.fees">{T["knowledge.fees"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.fees.1">{T["knowledge.fees.1"]}</li>
    <li data-i18n="knowledge.fees.2">{T["knowledge.fees.2"]}</li>
    <li data-i18n="knowledge.fees.3">{T["knowledge.fees.3"]}</li>
  </ul>
</section>

<section>
  <h2 class="text-lg font-semibold text-slate-100 mb-3" data-i18n="knowledge.further">{T["knowledge.further"]}</h2>
  <ul class="space-y-2 text-sm text-slate-400">
    <li data-i18n="knowledge.further.1">{T["knowledge.further.1"]}</li>
    <li data-i18n="knowledge.further.2">{T["knowledge.further.2"]}</li>
    <li data-i18n="knowledge.further.3">{T["knowledge.further.3"]}</li>
  </ul>
</section>

</div>

</BaseLayout>
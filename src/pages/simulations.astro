---
import BaseLayout from '../layouts/BaseLayout.astro';
import MonteCarloSimulator from '../components/MonteCarloSimulator.astro';
---

<BaseLayout title="Simulation Monte Carlo" description="Simulez l'évolution de vos investissements avec la méthode Monte Carlo.">

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-50">Simulation Monte Carlo</h1>
  <p class="mt-1 text-sm text-slate-400">
    Projetez l'évolution possible d'un investissement entre votre âge actuel et votre âge de retraite,
    à partir d'un rendement annuel composé (CAGR), d'un drawdown maximal estimé et d'une date d'arrêt des versements.
  </p>
  <p class="mt-2 text-xs text-slate-500">
    Renseignez un <strong class="text-slate-400">objectif final visé</strong> (en euros), puis utilisez les boutons d'optimisation
    pour calculer automatiquement l'investissement initial ou le versement mensuel nécessaire.
  </p>
</div>

<div class="rounded-xl border border-slate-800 bg-slate-900/40 p-0 overflow-hidden">
  <MonteCarloSimulator />
</div>

</BaseLayout>

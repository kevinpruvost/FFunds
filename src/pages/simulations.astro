---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readLang } from '../i18n/astro-i18n';
import { TRANSLATIONS } from '../i18n/translations';
import MonteCarloSimulator from '../components/MonteCarloSimulator';

const lang = readLang();
const T = TRANSLATIONS[lang];
---

<BaseLayout title={T["sim.title"]} description={T["sim.subtitle"]}>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-50" data-i18n="sim.title">{T["sim.title"]}</h1>
  <p class="mt-1 text-sm text-slate-400" data-i18n="sim.subtitle">{T["sim.subtitle"]}</p>
  <p class="mt-2 text-xs text-slate-500" data-i18n="sim.hint">{T["sim.hint"]}</p>
</div>

<MonteCarloSimulator client:load />

</BaseLayout>
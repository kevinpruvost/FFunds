---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readLang } from '../i18n/astro-i18n';
import { TRANSLATIONS } from '../i18n/translations';
import PortfolioAllocator from '../components/PortfolioAllocator';

const lang = readLang();
const T = TRANSLATIONS[lang];
---

<BaseLayout title={T["alloc.title"]} description={T["alloc.subtitle"]}>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-50" data-i18n="alloc.title">{T["alloc.title"]}</h1>
  <p class="mt-1 text-sm text-slate-400" data-i18n="alloc.subtitle">{T["alloc.subtitle"]}</p>
</div>

<PortfolioAllocator client:load />

</BaseLayout>
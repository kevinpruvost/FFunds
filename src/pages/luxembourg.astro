---

<BaseLayout title={T["lux.title"]} description={T["lux.subtitle"]}>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-slate-50" data-i18n="lux.title">{T["lux.title"]}</h1>
  <p class="mt-1 text-sm text-slate-400" data-i18n="lux.subtitle">{T["lux.subtitle"]}</p>
</div>

<div class="max-w-5xl space-y-10">

  <!-- ─── Why Luxembourg ─── -->
  <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-6">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-100" data-i18n="lux.why.title">
      <svg class="h-5 w-5 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m0 0a9 9 0 019 9"/>
      </svg>
      {T["lux.why.title"]}
    </h2>
    <p class="mb-3 text-sm text-slate-400 leading-relaxed" data-i18n="lux.why.p1">{T["lux.why.p1"]}</p>
    <p class="mb-3 text-sm text-slate-400 leading-relaxed" data-i18n="lux.why.p2">{T["lux.why.p2"]}</p>
    <p class="text-sm text-amber-400 leading-relaxed" data-i18n="lux.why.p3">{T["lux.why.p3"]}</p>
  </section>

  <!-- ─── Comparison Table ─── -->
  <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-6">
    <h2 class="mb-1 text-lg font-semibold text-slate-100">
      {isFr ? 'Tableau comparatif' : 'Comparison table'}
    </h2>
    <p class="mb-5 text-xs text-slate-500">
      {isFr
        ? 'Avantages, inconvénients et détails des frais pour chaque contrat luxembourgeois.'
        : 'Benefits, disadvantages and detailed fees for each Luxembourg contract.'}
    </p>

    <!-- Scrollable table wrapper with sort controls -->
    <div class="mb-3 flex items-center gap-2 text-xs text-slate-500">
      <span data-i18n="lux.table.sortBy">{T["lux.table.sortBy"]}</span>
      <span class="text-slate-600">·</span>
    </div>

    <div class="overflow-x-auto -mx-6 relative">
      <table class="w-full text-left text-xs" id="lux-compare-table">
        <thead>
          <tr class="border-b border-slate-700">
            <th class="sticky left-0 z-20 bg-slate-900 px-4 py-3 pr-6 text-xs font-semibold text-slate-300 whitespace-nowrap shadow-[2px_0_8px_-4px_rgba(0,0,0,0.6)]" data-sort-key="name">{T["lux.table.contract"]}</th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="min" data-sort-dir="">{T["lux.table.min"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="mgmt" data-sort-dir="">{T["lux.table.mgmtFees"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="entry" data-sort-dir="">{T["lux.table.entryFees"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="solvency" data-sort-dir="">{T["lux.table.solvency"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="assets" data-sort-dir="">{T["lux.table.assets"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 cursor-pointer hover:text-slate-100 select-none whitespace-nowrap" data-sort-key="year" data-sort-dir="">{T["lux.table.seniority"]} <span class="sort-arrow text-slate-600">↕</span></th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap">{T["lux.table.switchFees"]}</th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap">{T["lux.table.exitFees"]}</th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap">{T["lux.table.structFees"]}</th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap">{T["lux.table.ucFees"]}</th>
            <th class="px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap">{T["lux.table.euroFees"]}</th>
          </tr>
        </thead>
        <tbody id="lux-table-body">
          {providers.filter(p => p.name !== "Monument Assurance Lux.").map((p) => {
            const fees = feeDetails[p.name];
            return (
              <tr class="border-b border-slate-800 hover:bg-slate-800/30 transition-colors"
                  data-min-val={p.minInvestmentVal}
                  data-mgmt-val={p.mgmtFeesVal}
                  data-entry-val={p.entryFeesVal}

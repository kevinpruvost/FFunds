                <td class="px-4 py-3 text-slate-400 tabular-nums whitespace-nowrap">{fees?.structFees ?? 'N/C'}</td>
                <td class="px-4 py-3 text-slate-400 tabular-nums whitespace-nowrap">{fees?.ucFees ?? 'N/C'}</td>
                <td class="px-4 py-3 text-slate-400 tabular-nums whitespace-nowrap">{fees?.euroFees ?? 'N/C'}</td>

import BaseLayout from '../layouts/BaseLayout.astro';
import { readLang } from '../i18n/astro-i18n';
import { TRANSLATIONS } from '../i18n/translations';

const lang = readLang();
const T = TRANSLATIONS[lang];
const isFr = lang === 'fr';

type ProviderType = "insurer" | "distributor" | "white-label" | "not-found" | "lps";

interface Provider {
  name: string;
  nameKey: string;
  descKey: string;
  contactKey: string;
  minInvestment: string;       // display value e.g. "100 000 €"
  minInvestmentVal: number;    // sortable: min value in EUR, Infinity for "HNWI"/"Sur devis"
  mgmtFees: string;            // display e.g. "0,80 % – 1,20 %"
  mgmtFeesVal: number;         // sortable: lower bound %, NaN for "Sur devis"
  entryFees: string;           // display e.g. "0 % – 2 %"
  entryFeesVal: number;        // sortable: lower bound %, NaN for "Sur devis"
  supports: string;
  rating: string;
  type: ProviderType;
  isCaaRegistered: boolean;
  solvencyRatio: string;       // display e.g. "226 %", "A+", "N/C"
  solvencyVal: number;         // sortable: numeric %, -1 for non-numeric ratings
  totalAssets: string;         // display e.g. "> 20 Mds€", "N/C"
  assetsVal: number;           // sortable: value in millions €, -1 for N/C
  establishedYear: string;     // display e.g. "1995", "N/C"
  yearVal: number;             // sortable: year as number, -1 for N/C
}

const typeLabel = (t: ProviderType): string => {
  if (isFr) {
    switch (t) {
      case "insurer": return "Assureur lux. CAA";
      case "distributor": return "Distributeur CGPI";
      case "white-label": return "Marque blanche";
      case "lps": return "LPS (assureur étranger)";
      case "not-found": return "Non trouvé registre CAA";
    }
  }
  switch (t) {
    case "insurer": return "LU insurer (CAA)";
    case "distributor": return "Distributor/advisor";
    case "white-label": return "White-label";
    case "lps": return "LPS (foreign insurer)";
    case "not-found": return "Not in CAA registry";
  }
};

const typeBadgeColor = (t: ProviderType): string => {
  switch (t) {
    case "insurer": return "border-emerald-700/30 text-emerald-400 bg-emerald-500/10";
    case "distributor": return "border-amber-700/30 text-amber-400 bg-amber-500/10";
    case "white-label": return "border-blue-700/30 text-blue-400 bg-blue-500/10";
    case "lps": return "border-purple-700/30 text-purple-400 bg-purple-500/10";
    case "not-found": return "border-red-700/30 text-red-400 bg-red-500/10";
  }
};


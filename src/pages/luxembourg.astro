                </span>
                <span class="text-xs">{p.rating}</span>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed mb-2" data-i18n={p.descKey}>{T[p.descKey]}</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
                <span>
                  <span class="text-slate-500">{isFr ? 'Min.' : 'Min.'}</span>
                  <span class="text-slate-400 font-medium tabular-nums">{p.minInvestment}</span>
                </span>
                <span>
                  <span class="text-slate-500">{isFr ? 'Frais gest.' : 'Mgmt fees'}</span>
                  <span class="text-slate-400 font-medium tabular-nums">{p.mgmtFees}</span>
                </span>
                <span>
                  <span class="text-slate-500">{isFr ? 'Frais entrée' : 'Entry fees'}</span>
                  <span class="text-slate-400 font-medium tabular-nums">{p.entryFees}</span>
                </span>
              </div>
            </div>
            <div class="shrink-0">
              <a href={`https://www.${T[p.contactKey]}`} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800/50 px-3 py-1.5 text-xs font-medium text-slate-300 transition-all hover:border-purple-500/40 hover:bg-slate-800 hover:text-purple-300">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span data-i18n={p.contactKey}>{T[p.contactKey]}</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-4 text-[10px] text-slate-600 leading-relaxed">
      {isFr
        ? 'Source : Registre CAA Luxembourg (caa.lu, juillet 2026). 28 assureurs-vie agréés au Luxembourg, dont 25 accessibles aux résidents français. Les entités marquées "Non trouvé registre CAA" ne figurent pas dans le registre officiel — il peut s\'agir d\'anciens noms commerciaux, de distributeurs ou d\'entités radiées.'
        : 'Source: CAA Luxembourg registry (caa.lu, July 2026). 28 life insurers licensed in Luxembourg, of which 25 are accessible to French residents. Entities marked "Not in CAA registry" do not appear in the official register — they may be legacy trade names, distributors, or deregistered entities.'}
    </p>
  </section>

</div>

<script>
  (function() {
    const table = document.getElementById('lux-compare-table');
    const tbody = document.getElementById('lux-table-body');
    if (!table || !tbody) return;

    const sortKeyMap = {
      min: 'minVal',
      mgmt: 'mgmtVal',
      entry: 'entryVal',
      solvency: 'solvencyVal',
      assets: 'assetsVal',
      year: 'yearVal',
    };

    const rows = Array.from(tbody.querySelectorAll('tr'));
    const originalOrder = rows.slice();

    function sortTable(key, dir) {
      const attr = sortKeyMap[key];
      if (!attr) return;

      const sorted = rows.slice().sort((a, b) => {
        let va = parseFloat(a.dataset[attr] || '0');
        let vb = parseFloat(b.dataset[attr] || '0');
        if (isNaN(va)) va = dir === 'asc' ? Infinity : -Infinity;
        if (isNaN(vb)) vb = dir === 'asc' ? Infinity : -Infinity;
        return dir === 'asc' ? va - vb : vb - va;
      });

      sorted.forEach(r => tbody.appendChild(r));

      document.querySelectorAll('th[data-sort-key] .sort-arrow').forEach(arrow => {
        arrow.textContent = '↕';
        arrow.classList.remove('text-purple-400');
        arrow.classList.add('text-slate-600');
      });

      const activeTh = table.querySelector(`th[data-sort-key="${key}"]`);
      if (activeTh) {
        const arrow = activeTh.querySelector('.sort-arrow');
        if (arrow) {
          arrow.textContent = dir === 'asc' ? '↑' : '↓';
          arrow.classList.remove('text-slate-600');
          arrow.classList.add('text-purple-400');
        }
      }
    }

    function resetOrder() {
      originalOrder.forEach(r => tbody.appendChild(r));
      document.querySelectorAll('th[data-sort-key] .sort-arrow').forEach(arrow => {
        arrow.textContent = '↕';
        arrow.classList.remove('text-purple-400');
        arrow.classList.add('text-slate-600');
      });
    }

    table.querySelectorAll('th[data-sort-key]').forEach(th => {
      th.addEventListener('click', () => {
        const key = th.dataset.sortKey;
        if (key === 'name') return;

        let dir = th.dataset.sortDir || '';
        if (!dir) dir = 'asc';
        else if (dir === 'asc') dir = 'desc';
        else dir = '';

        th.dataset.sortDir = dir;

        if (!dir) {
          resetOrder();
        } else {
          sortTable(key, dir);
        }
      });
    });
  })();
</script>

</BaseLayout>
